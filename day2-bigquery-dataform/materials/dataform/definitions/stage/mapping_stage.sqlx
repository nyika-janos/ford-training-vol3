config {
  type: "table",
  schema: require("../../includes/config").stage_dataset,
  name: "mapping_stage"
}

js {
  const {
    raw_dataset
  } = require("../../includes/config");
}

SELECT DISTINCT
    CAST(MLI AS STRING) AS MLI,
    TRIM(Basket) AS Basket,
    TRIM(PCT) AS PCT,
    TRIM(MPL_Code) AS MPL_Code
FROM `${raw_dataset}.mli_mapping`
WHERE MLI IS NOT NULL
