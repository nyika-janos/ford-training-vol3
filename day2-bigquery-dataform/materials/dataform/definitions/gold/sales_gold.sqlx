config {
  type: "table",
  schema: require("../../includes/config").gold_dataset,
  name: "sales_gold"
}

SELECT
    market,
    segment,
    model,
    COUNT(DISTINCT dealer_code) AS dealer_count,
    SUM(units) AS total_units,
    SUM(revenue) AS total_revenue,
    SAFE_DIVIDE(SUM(revenue), SUM(units)) AS average_unit_revenue,
    COUNT(*) AS transaction_count,
    MIN(sales_date) AS first_sales_date,
    MAX(sales_date) AS last_sales_date
FROM ${ref("sales_enriched")}
GROUP BY
    market,
    segment,
    model
